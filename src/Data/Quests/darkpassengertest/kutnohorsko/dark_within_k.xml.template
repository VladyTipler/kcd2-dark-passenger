      <QuestName StringName="{{DP_QUEST_NAME}}" Text="Dark Within">
        <Localization Text="Dark Within" Language="WHS" />
      </QuestName>
      <QuestDescription StringName="{{DP_QUEST_DESCRIPTION_KEY}}" Text="I have learned to keep this darkness on a leash. To give it rules, and choose only those whose guilt leaves no room for doubt. But the hunger has returned, and I cannot hold it back for long.">
