<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
  <Skald>
    <Quest Name="{{DP_QUEST_NAME}}" Type="Activity" Players="0">
      <Ports>
        <Port Name="arm" Direction="In" Type="trigger">
          <DesignName Text="Arm satisfaction lifecycle" />
        </Port>
      </Ports>
{{DP_RUMOR_DIALOG_DEFINITION}}
      <Nodes>
{{DP_RUMOR_DIALOG_NODES}}
{{DP_WITNESS_NODES}}
        <State Name="watcherActive" TypeT="bool">
          <Edge From="arm" To="SetTrue" />
        </State>
        <Timer Name="bootDelay">
          <Constant Name="Duration" Value="2s" />
          <Constant Name="TimeType" Value="GameTime" />
          <Edge From="arm" To="SetRunning" />
        </Timer>
        <MakeArray Name="satisfactionTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="23" />
        </MakeArray>
        <MakeArray Name="targetTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="24" />
        </MakeArray>
        <MakeArray Name="revealTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="30" />
        </MakeArray>
        <MakeArray Name="firstLeadTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="31" />
        </MakeArray>
        <MakeArray Name="cleanResultTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="25" />
        </MakeArray>
        <MakeArray Name="controlledResultTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="26" />
        </MakeArray>
        <MakeArray Name="noisyResultTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="27" />
        </MakeArray>
        <MakeArray Name="externalResultTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="28" />
        </MakeArray>
        <MakeArray Name="witnessDetectedTags" TypeT="wh::rpgmodule::BuffDefinitionAITags">
          <Constant Name="A" Value="29" />
        </MakeArray>
        <BuffTagTrigger Name="targetTagTrigger">
          <Asset Name="Souls" Alias="RegionalTargetSouls" />
          <Edge From="targetTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="revealTagTrigger">
          <Asset Name="Souls" Alias="RegionalTargetSouls" />
          <Edge From="revealTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="firstLeadTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="firstLeadTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="satisfactionTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="satisfactionTags.Array" To="BuffTags" />
          <Edge From="watcherActive.State" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="cleanResultTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="cleanResultTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="controlledResultTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="controlledResultTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="noisyResultTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="noisyResultTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="externalResultTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="externalResultTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <BuffTagTrigger Name="witnessDetectedTrigger">
          <Asset Name="Souls" Alias="player" />
          <Edge From="witnessDetectedTags.Array" To="BuffTags" />
          <Edge From="questProgress.Active" To="IsActive" />
        </BuffTagTrigger>
        <State Name="satisfiedAtWake" TypeT="bool">
          <Edge From="satisfactionTrigger.OnAdded" To="SetTrue" />
          <Edge From="satisfactionTrigger.OnRemoved" To="SetFalse" />
        </State>
        <IfFunction Name="coldStartUnsatisfied" TypeT="bool" MethodName="Control::Compare" DeclaringType="Control">
          <Constant Name="Op" Value="Equals" />
          <Constant Name="ValueB" Value="false" />
          <Edge From="satisfiedAtWake.State" To="ValueA" />
          <Edge From="bootDelay.OnFinished" To="Exec" />
        </IfFunction>
        <IfFunction Name="coldStartQuestNotActive" TypeT="wh::questmodule::QuestProgress" MethodName="Control::Compare" DeclaringType="Control">
          <Constant Name="Op" Value="NotEquals" />
          <Constant Name="ValueB" Value="Active" />
          <Edge From="questProgress.State" To="ValueA" />
          <Edge From="coldStartUnsatisfied.True" To="Exec" />
        </IfFunction>
        <Timer Name="removeResetDelay">
          <Constant Name="Duration" Value="1s" />
          <Constant Name="TimeType" Value="GameTime" />
          <Edge From="satisfactionTrigger.OnRemoved" To="SetRunning" />
          <Edge From="coldStartQuestNotActive.True" To="SetRunning" />
        </Timer>
        <State Name="questProgress" RequiredForOutput="{{DP_REGION_ID}}" TypeT="wh::questmodule::QuestProgress">
          <Edge From="satisfactionTrigger.OnRemoved" To="SetNone" />
          <Edge From="coldStartQuestNotActive.True" To="SetNone" />
          <Edge From="removeResetDelay.OnFinished" To="SetActive" />
          <Edge From="cleanResultTrigger.OnAdded" To="SetDone" />
          <Edge From="controlledResultTrigger.OnAdded" To="SetDone" />
          <Edge From="noisyResultTrigger.OnAdded" To="SetDone" />
          <Edge From="externalResultTrigger.OnAdded" To="SetDone" />
        </State>
        <IfFunction Name="wakeQuestActive" TypeT="wh::questmodule::QuestProgress" MethodName="Control::Compare" DeclaringType="Control">
          <Constant Name="Op" Value="Equals" />
          <Constant Name="ValueB" Value="Active" />
          <Edge From="questProgress.State" To="ValueA" />
          <Edge From="bootDelay.OnFinished" To="Exec" />
        </IfFunction>
        <State Name="selectionRequestActive" TypeT="bool">
          <Edge From="questProgress.OnActive" To="SetTrue" />
          <Edge From="wakeQuestActive.True" To="SetTrue" />
          <Edge From="satisfactionTrigger.OnAdded" To="SetFalse" />
{{DP_TARGET_SELECTION_STOP_EDGES}}
        </State>
        <SetEntityContext Name="selectVictimRequest">
          <Constant Name="Context" Value="{{DP_REQUEST_CONTEXT}}" />
          <Asset Name="Souls" Alias="player" />
          <Edge From="selectionRequestActive.State" To="IsActive" />
        </SetEntityContext>
        <State Name="targetDeathContextActive" TypeT="bool">
          <Edge From="questProgress.OnActive" To="SetFalse" />
          <Edge From="satisfactionTrigger.OnAdded" To="SetFalse" />
          <Edge From="cleanResultTrigger.OnAdded" To="SetFalse" />
          <Edge From="controlledResultTrigger.OnAdded" To="SetFalse" />
          <Edge From="noisyResultTrigger.OnAdded" To="SetFalse" />
          <Edge From="externalResultTrigger.OnAdded" To="SetFalse" />
{{DP_TARGET_DEATH_CONTEXT_EDGES}}
        </State>
        <SetEntityContext Name="targetDeathRequest">
          <Constant Name="Context" Value="{{DP_TARGET_DEATH_CONTEXT}}" />
          <Asset Name="Souls" Alias="player" />
          <Edge From="targetDeathContextActive.State" To="IsActive" />
        </SetEntityContext>
{{DP_TARGET_DETECTION_NODES}}
{{DP_TARGET_DEATH_NODES}}
        <Function Name="grantSatisfactionOnCleanResult" MethodName="wh::rpgmodule::AddBuff" DeclaringType="wh::rpgmodule">
          <Asset Name="Souls" Alias="player" />
          <Constant Name="Buff" Value="b5c59e05-cc10-4bf8-b82e-d82b913c841f" />
          <Edge From="cleanResultTrigger.OnAdded" To="Exec" />
        </Function>
        <Function Name="grantSatisfactionOnControlledResult" MethodName="wh::rpgmodule::AddBuff" DeclaringType="wh::rpgmodule">
          <Asset Name="Souls" Alias="player" />
          <Constant Name="Buff" Value="b5c59e05-cc10-4bf8-b82e-d82b913c841f" />
          <Edge From="controlledResultTrigger.OnAdded" To="Exec" />
        </Function>
        <Function Name="grantSatisfactionOnNoisyResult" MethodName="wh::rpgmodule::AddBuff" DeclaringType="wh::rpgmodule">
          <Asset Name="Souls" Alias="player" />
          <Constant Name="Buff" Value="b5c59e05-cc10-4bf8-b82e-d82b913c841f" />
          <Edge From="noisyResultTrigger.OnAdded" To="Exec" />
        </Function>
        <State Name="objectiveProgress" TypeT="{{DP_SEARCH_PROGRESS_TYPE}}">
          <Edge From="satisfactionTrigger.OnRemoved" To="SetNone" />
          <Edge From="questProgress.OnActive" To="SetNone" />
{{DP_SEARCH_STATE_EDGES}}
{{DP_TARGET_SEARCH_REVEAL_EDGES}}
{{DP_TARGET_SEARCH_RESET_EDGES}}
        </State>
        <{{DP_SEARCH_OBJECTIVE_NAME}} Name="visual">
          <Edge From="objectiveProgress.State" To="Progress" />
        </{{DP_SEARCH_OBJECTIVE_NAME}}>
        <State Name="evidenceProgress" TypeT="DP_EvidenceProgress">
          <Edge From="satisfactionTrigger.OnRemoved" To="SetNone" />
          <Edge From="firstLeadTrigger.OnAdded" To="SetFirstLead" />
{{DP_EVIDENCE_WITNESS_EDGE}}
          <Edge From="revealTagTrigger.OnAdded" To="SetDone" />
        </State>
        <{{DP_EVIDENCE_OBJECTIVE_NAME}} Name="evidenceVisual">
          <Edge From="evidenceProgress.State" To="Progress" />
        </{{DP_EVIDENCE_OBJECTIVE_NAME}}>
{{DP_WITNESS_OBJECTIVE_NODES}}
        <State Name="selectedTarget" TypeT="{{DP_SELECTED_TARGET_TYPE}}">
          <Edge From="satisfactionTrigger.OnRemoved" To="SetNone" />
          <Edge From="questProgress.OnActive" To="SetNone" />
{{DP_SELECTED_STATE_EDGES}}
        </State>
        <State Name="targetObjectiveProgress" TypeT="{{DP_TARGET_PROGRESS_TYPE}}">
          <Edge From="satisfactionTrigger.OnRemoved" To="SetNone" />
          <Edge From="questProgress.OnActive" To="SetNone" />
{{DP_TARGET_STATE_EDGES}}
        </State>
        <{{DP_TARGET_OBJECTIVE_NAME}} Name="targetVisual">
          <Edge From="targetObjectiveProgress.State" To="Progress" />
        </{{DP_TARGET_OBJECTIVE_NAME}}>
        <State Name="cleanupProgress" TypeT="DP_CleanupProgress">
          <Edge From="satisfactionTrigger.OnRemoved" To="SetNone" />
          <Edge From="questProgress.OnActive" To="SetNone" />
{{DP_TARGET_CLEANUP_EDGES}}
          <Edge From="witnessDetectedTrigger.OnAdded" To="SetWitnessed" />
          <Edge From="cleanResultTrigger.OnAdded" To="SetClean" />
          <Edge From="controlledResultTrigger.OnAdded" To="SetControlled" />
          <Edge From="noisyResultTrigger.OnAdded" To="SetNoisy" />
          <Edge From="externalResultTrigger.OnAdded" To="SetExternal" />
        </State>
        <{{DP_CLEANUP_OBJECTIVE_NAME}} Name="cleanupVisual">
          <Edge From="cleanupProgress.State" To="Progress" />
        </{{DP_CLEANUP_OBJECTIVE_NAME}}>
        <Output Name="Output">
          <Edge From="questProgress.State" To="Progress" />
        </Output>
      </Nodes>
