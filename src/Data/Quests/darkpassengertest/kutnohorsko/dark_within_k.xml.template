          </LocalizedName>
          <Logs>
            <EnumLog Type="None" Name="None" />
            <EnumLog Type="Started" Name="FirstLead" IsTracked="true">
              <Log StringName="dark_within_evidence_first_lead" Text="An innkeeper hears more than he says. His rumor confirms that someone here has deeds worth examining. I need more proof.">
