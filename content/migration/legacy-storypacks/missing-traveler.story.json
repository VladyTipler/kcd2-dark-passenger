{
  "schemaVersion": 1,
  "id": "missing-traveler",
  "compatibleArchetypes": ["paper-trail-witness"],
  "truth": {
    "innocentVictim": {"id": "matej", "ru": "Матей", "en": "Matej"},
    "crime": {"id": "robbery-murder", "ru": "ограбление и убийство", "en": "robbery and murder"},
    "motive": {"id": "widow-money", "ru": "деньги вдовы", "en": "the widow's money"},
    "coverStory": {"id": "forged-departure", "ru": "поддельный отъезд", "en": "a forged departure"},
    "escapedJustice": {"id": "body-never-found", "ru": "тело не нашли", "en": "the body was never found"}
  },
  "facts": [
    {"id": "matej_missing", "category": "crime"},
    {"id": "horse_returned", "category": "corroboration"},
    {"id": "ledger_suspicious", "category": "coverup"},
    {"id": "forged_departure", "category": "coverup"},
    {"id": "culprit_knew_money", "category": "motive"},
    {"id": "horse_returner_identified", "category": "identity"},
    {"id": "widow_money_argument", "category": "motive"}
  ],
  "threads": [
    {
      "id": "paper-trail",
      "lead": {
        "mode": "case_start",
        "requiresFacts": [],
        "directionAsset": "direction.paper"
      },
      "entryStepIds": ["ask-innkeeper", "read-ledger"],
      "steps": [
        {
          "id": "ask-innkeeper",
          "kind": "lead",
          "action": {
            "evidenceModule": "source-dialogue",
            "bindings": {"source": "rumorSource"}
          },
          "requiresFacts": [],
          "presentations": [
            {
              "id": "ledger-unknown",
              "when": {"allKnown": [], "allUnknown": ["forged_departure"]},
              "content": {
                "prompt": "dialogue.rumor.prompt",
                "responses": ["dialogue.rumor.response"],
                "journal": "journal.rumor"
              }
            },
            {
              "id": "ledger-known",
              "when": {"allKnown": ["forged_departure"], "allUnknown": []},
              "content": {
                "prompt": "dialogue.rumor.foundPrompt",
                "responses": ["dialogue.rumor.foundResponse"],
                "journal": "journal.rumor"
              }
            }
          ],
          "result": {
            "revealsFacts": ["matej_missing", "horse_returned", "ledger_suspicious"],
            "nextStepIds": ["read-ledger"],
            "unlockThreadIds": ["horse-witness"]
          }
        },
        {
          "id": "read-ledger",
          "kind": "search",
          "action": {
            "evidenceModule": "document-in-container",
            "bindings": {"container": "evidenceContainer"}
          },
          "requiresFacts": [],
          "presentations": [
            {
              "id": "default",
              "when": {"allKnown": [], "allUnknown": []},
              "content": {
                "name": "document.ledger.name",
                "info": "document.ledger.info",
                "body": "document.ledger.body",
                "journal": "journal.ledger"
              }
            }
          ],
          "result": {
            "revealsFacts": ["forged_departure", "culprit_knew_money"],
            "nextStepIds": [],
            "unlockThreadIds": ["horse-witness"]
          }
        }
      ]
    },
    {
      "id": "horse-witness",
      "lead": {
        "mode": "fact",
        "requiresFacts": ["horse_returned"],
        "directionAsset": "direction.witness"
      },
      "entryStepIds": ["question-witness"],
      "steps": [
        {
          "id": "question-witness",
          "kind": "communication",
          "action": {
            "evidenceModule": "witness-dialogue",
            "bindings": {"witness": "witness"}
          },
          "requiresFacts": ["horse_returned"],
          "presentations": [
            {
              "id": "default",
              "when": {"allKnown": [], "allUnknown": []},
              "content": {
                "prompt": "dialogue.witness.prompt",
                "responses": ["dialogue.witness.response"],
                "journal": "journal.witness"
              }
            }
          ],
          "result": {
            "revealsFacts": ["horse_returner_identified"],
            "nextStepIds": [],
            "unlockThreadIds": []
          }
        }
      ]
    },
    {
      "id": "courtyard-gossip",
      "lead": {
        "mode": "ambient",
        "requiresFacts": [],
        "directionAsset": "direction.overheard"
      },
      "entryStepIds": ["overhear-argument"],
      "steps": [
        {
          "id": "overhear-argument",
          "kind": "lead",
          "action": {
            "evidenceModule": "overheard-dialogue",
            "bindings": {
              "speakerA": "gossipSourceA",
              "speakerB": "gossipSourceB"
            }
          },
          "requiresFacts": [],
          "presentations": [
            {
              "id": "default",
              "when": {"allKnown": [], "allUnknown": []},
              "content": {
                "responses": ["dialogue.overheard.response"],
                "journal": "journal.overheard"
              }
            }
          ],
          "result": {
            "revealsFacts": ["widow_money_argument"],
            "nextStepIds": [],
            "unlockThreadIds": []
          }
        }
      ]
    }
  ],
