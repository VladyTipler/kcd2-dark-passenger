{
  "schemaVersion": 2,
  "storyId": "composed-case-probe",
  "threads": [
    {
      "id": "paper-trail",
      "archetypeId": "paper-trail",
      "lead": {
        "mode": "case_start",
        "requiresFacts": [],
        "directionAsset": "direction.paper"
      },
      "entryStepIds": ["ask-innkeeper"],
      "steps": [
        {
          "id": "ask-innkeeper",
          "kind": "lead",
          "action": {
            "evidenceModule": "source-dialogue",
            "bindings": {"source": "rumorSource"}
          },
          "guidance": [
            {
              "id": "settlement-search",
              "target": {"kind": "area", "slot": "settlement"},
              "precision": "area",
              "objective": {
                "nameAsset": "objective.guidance.search.name",
                "states": {"active": "objective.guidance.search.active"}
              }
            },
            {
              "id": "find-source",
              "target": {"kind": "actor", "slot": "rumorSource"},
              "precision": "exact"
            }
          ],
          "requiresFacts": [],
          "presentations": [
            {
              "id": "default",
              "when": {"allKnown": [], "allUnknown": []},
              "content": {
                "prompt": "dialogue.innkeeper.prompt",
                "responses": ["dialogue.innkeeper.response"],
                "journal": "journal.rumor"
              }
            }
          ],
          "result": {
            "revealsFacts": ["traveler_missing"],
            "nextStepIds": ["read-letter"],
            "unlockThreadIds": []
          }
        },
        {
          "id": "read-letter",
          "kind": "search",
          "action": {
            "evidenceModule": "document-in-container",
            "bindings": {"container": "evidenceContainer"},
            "placement": {"mode": "world-container"},
            "item": {
              "classification": "quest",
              "retention": "case"
            }
          },
          "guidance": [
            {
              "id": "find-container",
              "target": {"kind": "entity", "slot": "evidenceContainer"},
              "precision": "exact"
            },
            {
              "id": "search-place",
              "target": {"kind": "place", "slot": "evidenceContainer"},
              "precision": "point"
            }
          ],
          "requiresFacts": ["traveler_missing"],
          "presentations": [
            {
              "id": "default",
              "when": {"allKnown": [], "allUnknown": []},
              "content": {
                "name": "document.letter.name",
                "info": "document.letter.info",
                "body": "document.letter.body",
                "journal": "journal.letter"
              }
            }
          ],
          "result": {
            "revealsFacts": ["letter_links_target"],
            "nextStepIds": [],
            "unlockThreadIds": ["witness-web"]
          }
        }
      ]
    },
    {
