          },
          "requiresFacts": [],
          "presentations": [
            {
              "id": "default",
              "when": {"allKnown": [], "allUnknown": []},
              "content": {
                "responses": ["dialogue.overheard.interaction"],
                "journal": "journal.overheard.interaction"
              }
            }
          ],
          "result": {
            "revealsFacts": ["interaction_rumor_heard"],
            "nextStepIds": [],
            "unlockThreadIds": []
          }
        }
      ]
