          "guidance": [
            {
              "id": "find-witness",
              "target": {"kind": "actor", "slot": "witness"},
              "precision": "exact"
            },
            {
              "id": "revealed-target",
              "target": {"kind": "actor", "slot": "target"},
              "precision": "exact",
              "visibility": {"mode": "target-revealed"},
