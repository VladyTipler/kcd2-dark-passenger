{
  "schemaVersion": 2,
  "id": "paper-trail",
  "slots": {
    "settlement": {
      "entityType": "settlement",
      "required": true,
      "capabilities": [],
      "templateFields": ["displayName"]
    },
    "target": {
      "entityType": "actor",
      "required": true,
      "capabilities": ["person.killable", "victim.eligible"],
      "identityModes": ["named", "titled", "anonymous"],
      "templateFields": ["displayLabel", "directionLabel", "name"]
    },
    "rumorSource": {
      "entityType": "actor",
      "required": true,
      "capabilities": ["role.innkeeper", "interaction.dialogue"],
      "identityModes": ["named", "titled", "anonymous"],
      "templateFields": ["displayLabel", "directionLabel", "name"]
    },
    "evidenceContainer": {
      "entityType": "container",
      "required": true,
      "capabilities": ["container.evidence"],
      "templateFields": ["locationHint"]
    }
  },
  "threadRules": {
    "minimum": 1,
    "maximum": 2,
    "allowedLeadModes": ["case_start", "fact"],
    "allowedStepKinds": ["lead", "search"],
    "allowBranching": true,
    "allowConvergence": true,
    "allowOutOfOrder": false
  },
  "evidenceRules": {
    "source-dialogue": {"confidence": 20, "minimum": 1, "maximum": 1},
    "document-in-container": {"confidence": 30, "minimum": 1, "maximum": 1}
  }
}
