{
  "schemaVersion": 2,
  "id": "witness-web",
  "slots": {
    "target": {
      "entityType": "actor",
      "required": true,
      "capabilities": ["person.killable", "victim.eligible"],
      "identityModes": ["named", "titled", "anonymous"],
      "templateFields": ["displayLabel", "directionLabel", "name"]
    },
    "witness": {
      "entityType": "actor",
      "required": true,
      "capabilities": ["interaction.dialogue"],
      "identityModes": ["named", "titled", "anonymous"],
      "templateFields": ["displayLabel", "directionLabel", "name"]
    }
  },
  "threadRules": {
    "minimum": 1,
    "maximum": 2,
    "allowedLeadModes": ["fact"],
    "allowedStepKinds": ["communication"],
    "allowBranching": true,
    "allowConvergence": true,
    "allowOutOfOrder": false
  },
  "evidenceRules": {
    "witness-dialogue": {"confidence": 25, "minimum": 1, "maximum": 1}
  }
}
